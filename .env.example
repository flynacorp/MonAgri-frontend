# Copier en .env.local et renseigner.
# Ces valeurs partent dans le navigateur : ce ne sont PAS des secrets
# (URL + clé publishable/anon), mais on les garde hors du dépôt par habitude.

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# URL de l'API MonAgri-backend — sans slash final.
# En local : http://localhost:3000
# En prod (Vercel) : l'URL du service Render, ex. https://monagri-api.onrender.com
VITE_API_URL=http://localhost:3000

# Affiche aux agriculteurs le bloc « Paiements en ligne » (création du compte
# Stripe). À laisser VIDE tant que Stripe est en mode test : les producteurs du
# pilote ne voient pas le bloc et leurs clients paient au retrait.
# VITE_PAIEMENTS_EN_LIGNE=oui

# Clé PUBLIQUE Stripe (pk_test_... en test) — Dashboard Stripe > Developers > API keys.
# Faite pour être dans le navigateur ; la clé secrète (sk_...) reste sur le serveur.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
